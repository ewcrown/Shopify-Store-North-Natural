{% assign s = section.settings %}
<section class="ac-blogs ac-related-blogs" id="ac-related-blogs">
  <div class="ac-blogs-row">
    <div class="section">
      <div class="ac-related-blogs-title">
        <h3>Related Blogs</h3>
      </div>
      <div class="ac-blogs-wrap">
        {% for article in blog.articles limit:4 %}
          {% render 'ac-blog-card', category: s.blog, article: article %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Related Blogs",
  "settings": [  ],
  "presets": [
    {
      "name": "<> Related Blogs"
    }
  ]
}
{% endschema %}
